FROM node:20-bookworm-slim

# canvas necesita estas librerías nativas del sistema para compilar en npm install
RUN apt-get update && apt-get install -y \
    build-essential \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    openssl \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
# El postinstall script corre "prisma generate", que necesita el schema
# presente ANTES de npm ci (si no, falla con "Could not find Prisma Schema").
COPY prisma ./prisma
RUN npm ci

COPY . .

CMD ["npm", "run", "worker"]

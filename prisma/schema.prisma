// Configuración del generador de cliente
generator client {
  provider = "prisma-client-js"
}

// Configuración de la base de datos
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELO DE USUARIOS Y ROLES
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          UserRole  @default(USER)
  
  // Relaciones
  apiKeys       ApiKey[]
  planos        Plano[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  API_CLIENT
}

// ==========================================
// API KEYS (ACCESO EXTERNO)
// ==========================================

model ApiKey {
  id            String    @id @default(cuid())
  key           String    @unique  // Hash bcrypt de la API Key real (legacy, solo para verificación)
  keyHash       String?   @unique  // Hash SHA-256 de la API Key real, usado para lookup O(1)
  name          String               // Nombre descriptivo (ej: "App Terralima Producción")
  prefix        String               // Primeros caracteres visibles para identificarla

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  permissions   String[]             // Ej: ["planos:generate", "planos:read"]
  rateLimit     Int       @default(100)  // Límite de peticiones por hora
  
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("api_keys")
  @@index([userId])
}

// ==========================================
// MODELO PRINCIPAL: PLANOS
// ==========================================

model Plano {
  id            String     @id @default(cuid())
  
  // --- Identificación del Lote ---
  loteCodigo    String               // Ej: "E01MZC014P"
  loteNombre    String               // Ej: "Lote 14 - Manzana C - Etapa 1"
  manzana       String
  etapa         String
  numeroLote    String

  // Ubicación administrativa (departamento/provincia/distrito/direccion/zonaUTM).
  // Antes solo vivía de paso en el job de Redis durante la generación y se
  // descartaba — no había forma de auditar qué ubicación se usó en un plano
  // ya generado. Nullable porque los registros previos a este campo no la
  // tienen.
  ubicacion     Json?

  // --- Geometría y Datos Técnicos (JSON) ---
  vertices      Json                 // Array de coordenadas [x, y]
  dimensiones   Json                 // Objeto con {frente, fondo, area, perimetro...}
  
  // Colindancias Detalladas
  // Almacena array de objetos: [{ lado: "FRENTE", tipo: "calle", nombre: "...", longitud: 10.00 }]
  colindancias  Json                 
  
  // [MEJORA] Contexto Vectorial
  // Almacena la geometría de los vecinos para poder regenerar el plano idéntico en el futuro.
  // Estructura: { radioBusqueda: 50, elementos: [{ tipo: "LOTE", vertices: [...] }] }
  contexto      Json?                
  
  // --- Metadatos Adicionales ---
  propietario   Json?                // Datos del cliente/propietario
  
  // --- Archivos Resultantes ---
  pdfUrl        String?              // URL pública/privada del PDF generado en S3/Blob
  pdfSize       Int?                 // Tamaño en bytes
  dxfUrl        String?              // URL del archivo DXF (CAD) generado por el servicio Python
  dxfSize       Int?                 // Tamaño del DXF en bytes
  thumbnailUrl  String?              // Imagen previa del plano
  
  // --- Estado del Proceso (Job Queue) ---
  status        PlanoStatus @default(PENDING)
  jobId         String?              // ID del trabajo en BullMQ/Redis
  errorMessage  String?              // Mensaje de error si falla
  
  // --- Configuración Usada ---
  config        Json                 // Configuración específica de esa generación (escala, formatos)
  
  // --- Auditoría ---
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  source        String     @default("api")  // Origen: "api", "dashboard", "app-movil"
  
  generatedAt   DateTime?            // Fecha exacta de finalización
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@map("planos")
  @@index([loteCodigo])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PlanoStatus {
  PENDING      // Encolado, esperando worker
  PROCESSING   // Generándose actualmente
  COMPLETED    // PDF listo y subido
  FAILED       // Error en generación
  CANCELLED    // Cancelado por usuario o timeout
}

// ==========================================
// DESCARGAS DE DOCUMENTO RESUMEN
// ==========================================

// Auditoría del documento "resumen" (Memoria: solo sección III de linderos +
// Plano Perimétrico Copia) — pensado para staff no-administrador, que hoy no
// tiene acceso al expediente completo. A diferencia de Plano, este documento
// se genera al vuelo en cada descarga (sin llamadas externas, rápido) y no
// se persiste — por eso no hay pdfUrl acá, solo el registro de que se pidió.
// staffUid/staffNombre identifican al usuario de mapa_renasur (Odoo uid), no
// a un User de este sistema — mapa_renasur no comparte su base de datos con
// plan_pro, así que viajan como datos sueltos en el payload de la request.
model PlanoDescarga {
  id            String   @id @default(cuid())

  loteCodigo    String
  staffUid      Int?
  staffNombre   String?

  createdAt     DateTime @default(now())

  @@map("plano_descargas")
  @@index([loteCodigo])
  @@index([staffUid])
  @@index([createdAt])
}

// ==========================================
// LOGS DE AUDITORÍA API
// ==========================================

model ApiLog {
  id            String    @id @default(cuid())
  
  apiKeyId      String?
  endpoint      String
  method        String
  statusCode    Int
  duration      Int                  // Duración en milisegundos
  
  ipAddress     String?
  userAgent     String?
  
  requestBody   Json?                // Opcional: guardar payload (cuidado con datos sensibles)
  responseBody  Json?                // Opcional: guardar respuesta
  metadata      Json?                // Metadatos extra (ej: estrategia de contexto usada)
  errorMessage  String?
  
  createdAt     DateTime  @default(now())
  
  @@map("api_logs")
  @@index([apiKeyId])
  @@index([createdAt])
  @@index([endpoint])
}